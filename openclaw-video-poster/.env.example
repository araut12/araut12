# --- AI video generation (Replicate) ---
REPLICATE_API_TOKEN=
# Any Replicate text-to-video model, as owner/name
REPLICATE_VIDEO_MODEL=minimax/video-01

# --- YouTube ---
# OAuth "Desktop app" client downloaded from Google Cloud Console
YOUTUBE_CLIENT_SECRETS=./secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=./secrets/youtube_token.json
# public | unlisted | private
YOUTUBE_PRIVACY=public

# --- TikTok (Content Posting API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_TOKEN_FILE=./secrets/tiktok_token.json
# Unaudited apps may only use SELF_ONLY. After TikTok audits your app: PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY=SELF_ONLY
